{
  "name": "yuxuanplugin",
  "displayName": "Yuxuan Dev Assistant",
  "description": "Yuxuan Dev Assistant — 面向 Java(V5) 开发的 VS Code 效率插件",
  "version": "0.0.2",
  "publisher": "SirYuxuan",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirYuxuan/vscode-plugin.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yuxuanplugin.copyOfArthas",
        "title": "Copy of arthas",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.findClass",
        "title": "寻找Class",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.upload",
        "title": "上传",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.delete",
        "title": "删除",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.uploadLast",
        "title": "重新上传上次文件",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.showUploadHistory",
        "title": "上传历史",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.findXmlReferences",
        "title": "查找 XML 引用",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.openToolbench",
        "title": "开发者工具台",
        "category": "工具"
      },
      {
        "command": "yuxuanplugin.sendHttpRequest",
        "title": "发送请求",
        "category": "HTTP"
      },
      {
        "command": "yuxuanplugin.selectHttpEnvironment",
        "title": "选择环境",
        "category": "HTTP"
      },
      {
        "command": "yuxuanplugin.llm.setApiKey",
        "title": "设置 API Key",
        "category": "Yuxuan LLM"
      },
      {
        "command": "yuxuanplugin.llm.clearApiKey",
        "title": "清除 API Key",
        "category": "Yuxuan LLM"
      },
      {
        "command": "yuxuanplugin.llm.testEndpoint",
        "title": "测试端点",
        "category": "Yuxuan LLM"
      },
      {
        "command": "yuxuanplugin.llm.openSettings",
        "title": "打开端点设置",
        "category": "Yuxuan LLM"
      },
      {
        "command": "yuxuanplugin.llm.showLogs",
        "title": "显示日志",
        "category": "Yuxuan LLM"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "yuxuanllm",
        "displayName": "Yuxuan LLM"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "yuxuanplugin.editorMenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "yuxuanplugin.explorerMenu",
          "group": "navigation",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)"
        }
      ],
      "yuxuanplugin.editorMenu": [
        {
          "command": "yuxuanplugin.copyOfArthas",
          "group": "1_arthas"
        },
        {
          "command": "yuxuanplugin.findClass",
          "when": "resourceExtname == .java",
          "group": "2_findClass"
        },
        {
          "command": "yuxuanplugin.findXmlReferences",
          "when": "resourceExtname == .java",
          "group": "2_findClass"
        },
        {
          "command": "yuxuanplugin.upload",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "3_upload"
        },
        {
          "command": "yuxuanplugin.delete",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "4_delete"
        }
      ],
      "yuxuanplugin.explorerMenu": [
        {
          "command": "yuxuanplugin.findClass",
          "when": "resourceExtname == .java",
          "group": "1_findClass"
        },
        {
          "command": "yuxuanplugin.findXmlReferences",
          "when": "resourceExtname == .java",
          "group": "1_findClass"
        },
        {
          "command": "yuxuanplugin.upload",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "2_upload"
        },
        {
          "command": "yuxuanplugin.delete",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "3_delete"
        }
      ]
    },
    "submenus": [
      {
        "id": "yuxuanplugin.editorMenu",
        "label": "V5Dev"
      },
      {
        "id": "yuxuanplugin.explorerMenu",
        "label": "V5Dev"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Yuxuan Dev Assistant Configuration",
      "properties": {
        "yuxuanplugin.server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "服务器IP地址",
          "scope": "resource",
          "order": 10
        },
        "yuxuanplugin.server.port": {
          "type": "number",
          "default": 22,
          "description": "服务器端口号",
          "scope": "resource",
          "order": 20
        },
        "yuxuanplugin.server.username": {
          "type": "string",
          "default": "",
          "description": "服务器登录账号",
          "scope": "resource",
          "order": 30
        },
        "yuxuanplugin.server.password": {
          "type": "string",
          "default": "",
          "description": "服务器登录密码",
          "scope": "resource",
          "order": 40
        },
        "yuxuanplugin.server.projectPath": {
          "type": "string",
          "default": "/opt/project",
          "description": "服务器上的项目路径",
          "scope": "resource",
          "order": 50
        },
        "yuxuanplugin.arthas.basePath": {
          "type": "string",
          "default": "/opt/arthas",
          "description": "Arthas的基础目录路径",
          "scope": "resource",
          "order": 60
        },
        "yuxuanplugin.upload.autoUploadOnSave": {
          "type": "boolean",
          "default": false,
          "description": "保存受支持目录（Java/WEB-INF/apps_res）内的文件时自动上传",
          "scope": "resource",
          "order": 70
        },
        "yuxuanplugin.http.timeout": {
          "type": "number",
          "default": 30000,
          "description": "HTTP 测试台请求超时时间（毫秒）",
          "scope": "resource",
          "order": 80
        },
        "yuxuanplugin.llm.endpoints": {
          "type": "array",
          "default": [
            {
              "id": "oofo",
              "name": "OOFO",
              "baseUrl": "https://ai.oofo.cc/v1",
              "models": [
                {
                  "id": "gpt-6.1-sol",
                  "name": "GPT 6.1 Sol",
                  "maxInputTokens": 984000,
                  "maxOutputTokens": 16000,
                  "toolCalling": true,
                  "vision": false
                }
              ]
            },
            {
              "id": "orbi",
              "name": "Orbi",
              "baseUrl": "https://api.orbiorbi.com/v1",
              "models": [
                {
                  "id": "gpt-6.1-sol",
                  "name": "GPT 6.1 Sol",
                  "maxInputTokens": 984000,
                  "maxOutputTokens": 16000,
                  "toolCalling": true,
                  "vision": false
                }
              ]
            }
          ],
          "description": "Yuxuan LLM 的 OpenAI 兼容端点列表（使用 /chat/completions）。API Key 通过命令「Yuxuan LLM: 设置 API Key」保存在 SecretStorage 中，不会写入设置。",
          "scope": "application",
          "items": {
            "type": "object",
            "required": [
              "id",
              "baseUrl",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "description": "端点唯一标识，仅允许字母、数字、下划线和连字符"
              },
              "name": {
                "type": "string",
                "description": "端点显示名称"
              },
              "baseUrl": {
                "type": "string",
                "description": "接口基础地址，例如 https://example.com/v1"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "附加请求头（请勿在此放置密钥）"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "发送给服务端的模型名"
                    },
                    "name": {
                      "type": "string",
                      "description": "模型显示名称"
                    },
                    "maxInputTokens": {
                      "type": "number",
                      "description": "最大输入 token 数"
                    },
                    "maxOutputTokens": {
                      "type": "number",
                      "description": "最大输出 token 数"
                    },
                    "toolCalling": {
                      "type": "boolean",
                      "description": "是否支持工具调用"
                    },
                    "vision": {
                      "type": "boolean",
                      "description": "是否支持图片输入"
                    }
                  }
                }
              }
            }
          },
          "order": 90
        },
        "yuxuanplugin.llm.requestTimeout": {
          "type": "number",
          "default": 120000,
          "description": "Yuxuan LLM 请求无响应超时时间（毫秒）",
          "scope": "application",
          "order": 91
        },
        "yuxuanplugin.llm.logRequests": {
          "type": "boolean",
          "default": false,
          "description": "是否在日志中记录脱敏的请求摘要（字段、工具名、图片数量、请求体大小），用于排查网关报错",
          "scope": "application",
          "order": 92
        }
      }
    },
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}

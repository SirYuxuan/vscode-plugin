{
  "name": "yuxuanplugin",
  "displayName": "Yuxuan Dev Assistant",
  "description": "Yuxuan Dev Assistant — 面向 Java(V5) 开发的 VS Code 效率插件",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yuxuanplugin.copyOfArthas",
        "title": "Copy of arthas",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.findClass",
        "title": "寻找Class",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.upload",
        "title": "上传",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.delete",
        "title": "删除",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.uploadLast",
        "title": "重新上传上次文件",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.showUploadHistory",
        "title": "上传历史",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.findXmlReferences",
        "title": "查找 XML 引用",
        "category": "V5Dev"
      },
      {
        "command": "yuxuanplugin.openToolbench",
        "title": "开发者工具台",
        "category": "工具"
      },
      {
        "command": "yuxuanplugin.sendHttpRequest",
        "title": "发送请求",
        "category": "HTTP"
      },
      {
        "command": "yuxuanplugin.selectHttpEnvironment",
        "title": "选择环境",
        "category": "HTTP"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "yuxuanplugin.editorMenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "yuxuanplugin.explorerMenu",
          "group": "navigation",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)"
        }
      ],
      "yuxuanplugin.editorMenu": [
        {
          "command": "yuxuanplugin.copyOfArthas",
          "group": "1_arthas"
        },
        {
          "command": "yuxuanplugin.findClass",
          "when": "resourceExtname == .java",
          "group": "2_findClass"
        },
        {
          "command": "yuxuanplugin.findXmlReferences",
          "when": "resourceExtname == .java",
          "group": "2_findClass"
        },
        {
          "command": "yuxuanplugin.upload",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "3_upload"
        },
        {
          "command": "yuxuanplugin.delete",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "4_delete"
        }
      ],
      "yuxuanplugin.explorerMenu": [
        {
          "command": "yuxuanplugin.findClass",
          "when": "resourceExtname == .java",
          "group": "1_findClass"
        },
        {
          "command": "yuxuanplugin.findXmlReferences",
          "when": "resourceExtname == .java",
          "group": "1_findClass"
        },
        {
          "command": "yuxuanplugin.upload",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "2_upload"
        },
        {
          "command": "yuxuanplugin.delete",
          "when": "(resourcePath =~ /src\\/main\\/java\\/com(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/WEB-INF(\\/|$)/) || (resourcePath =~ /src\\/main\\/webapp\\/apps_res(\\/|$)/)",
          "group": "3_delete"
        }
      ]
    },
    "submenus": [
      {
        "id": "yuxuanplugin.editorMenu",
        "label": "V5Dev"
      },
      {
        "id": "yuxuanplugin.explorerMenu",
        "label": "V5Dev"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Yuxuan Dev Assistant Configuration",
      "properties": {
        "yuxuanplugin.server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "服务器IP地址",
          "scope": "resource",
          "order": 10
        },
        "yuxuanplugin.server.port": {
          "type": "number",
          "default": 22,
          "description": "服务器端口号",
          "scope": "resource",
          "order": 20
        },
        "yuxuanplugin.server.username": {
          "type": "string",
          "default": "",
          "description": "服务器登录账号",
          "scope": "resource",
          "order": 30
        },
        "yuxuanplugin.server.password": {
          "type": "string",
          "default": "",
          "description": "服务器登录密码",
          "scope": "resource",
          "order": 40
        },
        "yuxuanplugin.server.projectPath": {
          "type": "string",
          "default": "/opt/project",
          "description": "服务器上的项目路径",
          "scope": "resource",
          "order": 50
        },
        "yuxuanplugin.arthas.basePath": {
          "type": "string",
          "default": "/opt/arthas",
          "description": "Arthas的基础目录路径",
          "scope": "resource",
          "order": 60
        },
        "yuxuanplugin.upload.autoUploadOnSave": {
          "type": "boolean",
          "default": false,
          "description": "保存受支持目录（Java/WEB-INF/apps_res）内的文件时自动上传",
          "scope": "resource",
          "order": 70
        },
        "yuxuanplugin.http.timeout": {
          "type": "number",
          "default": 30000,
          "description": "HTTP 测试台请求超时时间（毫秒）",
          "scope": "resource",
          "order": 80
        }
      }
    },
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
